<% layout("/layouts/boilerplate") %>
<div class="row mt-3">
    <div class="col-8 offset-3">

    <h3>
        <%= listing.title %>
    </h3></div>

    <div class="card col-6 offset-3 show-card">
        <img src="<%= listing.image.url %>>" class="card-img-top show-img" alt="listing_image">
        <div class="card-body">
          <p class="card-text">
            <%= listing.description %> <br>
            &#8377;<%= listing.price.toLocaleString("en-IN") %><br>
            <%= listing.location %> <br>
            <%= listing.country  %><br>


        </p>
        </div>
    </div>
    
    <br />
    <div class="btns">
        <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark col-1 offset-3 edit-btn">Edit </a>
        
    <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
        <button class="btn btn-dark offset-5">Delete </button>
    </form>
</div>

<div class="col-8 offset-3 mb-3">
    <hr/>
    <h4>Leave a review</h4>
    <form>
        <div class="mb-3 mt-3">
            <label for="rating" class="form-control" >Rating</label>
            <input type="range" id="rating" name="review[rating]" min="1" max="5"  class="form-range" >
        </div>
        <div  class="mb-3 mt-3">
            <label for="comment" class="form-control">Comment </label>
                <textarea name="review[comment]" id="comment" rows="5" col="30" class="form-control" placeholder="Write your comment here"></textarea>
            </div>
            <button class="btn btn-dark">Submit</button>
    </form>
</div>

   
  </div>
</div>


